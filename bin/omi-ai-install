#!/bin/bash

# Install (or re-install) Omi AI for this user. Safe to run repeatedly.
# Touches only: this project's .venv, ~/.local/share/omi-ai, ~/.local/bin/{omi-ai,omi-ask},
# and ~/.config/systemd/user/omi-ai.{socket,service}. The API key comes from `omi-ai setup`.

set -euo pipefail

PROJECT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
SHARE="$HOME/.local/share/omi-ai"
UNITS="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

(cd "$PROJECT" && uv sync --quiet)

mkdir -p "$SHARE" "$UNITS" "$HOME/.local/bin"
ln -sfn "$PROJECT/src/omi_ai/data/policy.json" "$SHARE/policy.json"
ln -sfn "$PROJECT/.venv/bin/omi-ai" "$HOME/.local/bin/omi-ai"
ln -sfn "$PROJECT/bin/omi-ask" "$HOME/.local/bin/omi-ask"

PORT=$("$PROJECT/.venv/bin/omi-ai" config get daemon.port)
sed "s|@PORT@|$PORT|" "$PROJECT/packaging/omi-ai.socket" >"$UNITS/omi-ai.socket"
sed "s|@PROJECT@|$PROJECT|" "$PROJECT/packaging/omi-ai.service.in" >"$UNITS/omi-ai.service"

systemctl --user daemon-reload
systemctl --user enable --now omi-ai.socket >/dev/null
systemctl --user try-restart omi-ai.service

echo "Omi AI installed."
if [[ ! -s ${XDG_CONFIG_HOME:-$HOME/.config}/omi-ai/api-key ]]; then
  echo "Next: run 'omi-ai setup' to add your TypeSafe API key."
fi
echo "Then bind a key to 'omi-ask' in ~/.config/hypr/bindings.lua if you want one."
