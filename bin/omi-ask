#!/bin/bash

# Ask Omi AI: type a request, see the resolved omarchy command, confirm, run.
# Nothing runs without an explicit "Run" pick. Destructive commands need a second,
# explicit confirmation. Unknown commands are refused outright.
# When no command fits (escalate), offer: hand the request to the coding agent,
# "did you mean" suggestions, rephrase, or cancel.

set -euo pipefail

POLICY="${OMI_AI_POLICY:-$HOME/.local/share/omi-ai/policy.json}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omi-ai"
URL="${OMI_AI_URL:-http://127.0.0.1:8127}"
mkdir -p "$STATE"

notify() { notify-send -a "Omi AI" "Omi AI" "$1"; }
record() { # query command confidence outcome
  jq -cn --arg q "$1" --arg c "$2" --arg conf "$3" --arg o "$4" \
    '{ts: now, q: $q, command: $c, confidence: ($conf | tonumber? // null), outcome: $o}' >>"$STATE/log.jsonl"
}
menu() { omarchy-menu-select "$@" -- --width 600 || echo Cancel; }

resp=""
total_ms=0

# Same summary as `omi-ai ask`, printed when the script finishes (debugging aid for now).
summary() {
  [[ -n $resp ]] || return 0
  jq -r --arg total "$total_ms" '
    (if .escalate then "ESCALATE (\(.kind)): \(.detail)"
     else "\(.command)  (\(.confidence * 100 | floor)%)" + (if .destructive then "  [DESTRUCTIVE: \(.destructive)]" else "" end) end),
    (.debug // {} | "  route=\(.route) scores=\(.scores | tojson) tokens=\(.tokens) cached=\(.cached) jev=\(.jev_ms)ms total=\($total)ms"),
    (if .escalate and ((.alternatives // []) | length > 0)
     then "  suggestions: " + ([.alternatives[] | "\(.command) (fits \(.fits))"] | join(", ")) else empty end)
  ' <<<"$resp"
}
trap summary EXIT

# run_pick <pick-json> <query> <already-confirmed:0|1>
# pick-json has argv, command, confidence, terminal (the top-level answer or one suggestion).
run_pick() {
  local pick=$1 q=$2 confirmed=$3 cmd conf pct argv_json reason choice confirm out
  local -a argv
  mapfile -t argv < <(jq -r '.argv[]' <<<"$pick")
  ((${#argv[@]} > 0)) || return 0
  cmd=$(jq -r .command <<<"$pick")
  conf=$(jq -r .confidence <<<"$pick")
  pct=$(awk -v c="$conf" 'BEGIN { printf "%d", c * 100 }')

  # GATE A: the command must be a real route in the live manifest.
  argv_json=$(printf '%s\n' "${argv[@]}" | jq -R . | jq -s .)
  omarchy commands --all --json | jq -e --argjson a "$argv_json" \
    'any(.commands[]; (.route | split(" ")) as $r | $a[0:($r | length)] == $r)' >/dev/null || {
    notify "Refusing: \"$cmd\" is not a known omarchy command."
    record "$q" "$cmd" "$conf" "refused-unknown"
    return 1
  }

  # GATE B: destructive routes (checked here independently of the daemon's own flag).
  reason=$(jq -r --argjson a "$argv_json" '
    .destructive | to_entries[] | (.key | split(" ")) as $r
    | select($a[0:($r | length)] == $r) | .value' "$POLICY" 2>/dev/null | head -n1)

  if ((confirmed)); then
    choice="Run: $cmd"
  else
    choice=$(menu "Run this? (${pct}% sure)" "Run: $cmd" "Copy" "Cancel")
  fi

  if [[ $choice == Run:* && -n $reason ]]; then
    confirm=$(menu "Destructive: $reason" "Cancel" "Yes, run: $cmd")
    [[ $confirm == Yes,* ]] || choice=Cancel
  fi

  case "$choice" in
    Run:*)
      record "$q" "$cmd" "$conf" "ran"
      if [[ $(jq -r .terminal <<<"$pick") == "true" ]]; then
        # Needs sudo or shows a TUI: run it where the user can see and answer it.
        omarchy-launch-floating-terminal-with-presentation "$cmd"
      elif out=$("${argv[@]}" 2>&1); then
        [[ -n $out ]] && notify "$(head -c 400 <<<"$out")"
      else
        notify "\"$cmd\" failed:\n$(head -c 400 <<<"$out")"
      fi
      ;;
    Copy)
      printf '%s' "$cmd" | wl-copy
      record "$q" "$cmd" "$conf" "copied"
      ;;
    *) record "$q" "$cmd" "$conf" "cancelled" ;;
  esac
}

# escalate_menu <query>: returns 0 when done, 2 to ask again (rephrase).
escalate_menu() {
  local q=$1 kind detail agent_row choice i
  local -a rows suggestions=()
  kind=$(jq -r .kind <<<"$resp")
  detail=$(jq -r '.detail // "No command fits that."' <<<"$resp")
  agent_row="Ask the agent: ${q:0:60}"

  # Running a suggestion now is exactly what a timed request didn't want.
  if [[ $kind != timing ]]; then
    mapfile -t suggestions < <(jq -r '.alternatives[]?.command' <<<"$resp")
  fi
  for i in "${!suggestions[@]}"; do suggestions[i]="Run: ${suggestions[i]}"; done

  # Questions and timed requests most likely want the agent; otherwise lead with suggestions.
  if [[ $kind == question || $kind == timing ]]; then
    rows=("$agent_row" "${suggestions[@]}")
  else
    rows=("${suggestions[@]}" "$agent_row")
  fi
  choice=$(menu "$detail" "${rows[@]}" "Rephrase" "Cancel")

  case "$choice" in
    "Ask the agent:"*)
      record "$q" "" "" "escalate-agent"
      setsid -f omarchy agent prompt "$q" >/dev/null 2>&1
      ;;
    Run:*)
      i=$(jq --arg c "${choice#Run: }" '[.alternatives[].command] | index($c)' <<<"$resp")
      record "$q" "${choice#Run: }" "" "escalate-picked-suggestion"
      run_pick "$(jq -c ".alternatives[$i]" <<<"$resp")" "$q" 1
      ;;
    Rephrase)
      record "$q" "" "" "escalate-rephrased"
      return 2
      ;;
    *) record "$q" "" "" "escalate-cancelled" ;;
  esac
}

q=${OMI_AI_QUERY:-}
while true; do
  if [[ -z $q ]]; then
    q=$(omarchy-menu-input "Ask Omarchy" --width 600) || exit 0
  fi
  [[ -z ${q// /} ]] && exit 0

  t0=$(date +%s%N)
  resp=$(curl -fsS --max-time 10 --get "$URL/ask" --data-urlencode "q=$q") || {
    notify "No response from omi-ai. Is the service installed? (omi-ai-install)"
    exit 1
  }
  total_ms=$((($(date +%s%N) - t0) / 1000000))

  if [[ $(jq -r .escalate <<<"$resp") != "true" ]]; then
    run_pick "$resp" "$q" 0
    exit
  fi

  rc=0
  escalate_menu "$q" || rc=$?
  ((rc == 2)) || exit 0
  summary
  q=""
done
